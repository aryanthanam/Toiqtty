+// Host hooks pending equivalent public C API entry points. These delegate to
+// Ghostty's own animation clock and Unicode-placeholder geometry implementation.
+pub fn toiqtty_tick(terminal_: terminal_c.Terminal, now_ms: u64) callconv(lib.calling_conv) u32 {
+    if (comptime !build_options.kitty_graphics) return std.math.maxInt(u32);
+    const wrapper = terminal_ orelse return std.math.maxInt(u32);
+    const delay = wrapper.terminal.screens.active.kitty_images.animationTick(wrapper.io.io(), now_ms) orelse return std.math.maxInt(u32);
+    return @intCast(@min(delay, std.math.maxInt(u32) - 1));
+}
+pub const VirtualCallback = *const fn (?*anyopaque, u32, u32, i32, i32, u32, u32, u32, u32, u32, u32, u32, u32) callconv(lib.calling_conv) void;
+pub fn toiqtty_virtual(terminal_: terminal_c.Terminal, cell_width: u32, cell_height: u32, context: ?*anyopaque, callback: VirtualCallback) callconv(lib.calling_conv) void {
+    if (comptime !build_options.kitty_graphics) return;
+    const wrapper = terminal_ orelse return;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const top = t.screens.active.pages.getTopLeft(.viewport);
+    const bot = t.screens.active.pages.getBottomRight(.viewport) orelse return;
+    var it = @import("../kitty/graphics_unicode.zig").placementIterator(top, bot);
+    while (it.next()) |p| {
+        const image = storage.imageById(p.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const rp = p.renderPlacement(storage, &image, cell_width, cell_height) catch continue;
+        if (rp.dest_width == 0 or rp.dest_height == 0) continue;
+        const vp = t.screens.active.pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+        callback(context, image.id, p.placement_id, @intCast(vp.viewport.x), @intCast(vp.viewport.y),
+            rp.offset_x, rp.offset_y, rp.dest_width, rp.dest_height,
+            rp.source_x, rp.source_y, rp.source_width, rp.source_height);
+    }
+}
