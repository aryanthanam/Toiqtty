+/// Narrow host adapter for the existing upstream drop-target effect.
+pub fn orotermDndTrampoline(handler: *Handler, event: @import("../kitty/dnd.zig").Event) void {
+    const wrapper = TerminalWrapper.fromHandler(handler);
+    const callback = wrapper.oroterm_dnd_callback orelse return;
+    callback(wrapper, wrapper.effects.userdata, @intFromEnum(event));
+}
