<Window x:Class="Toiqtty.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="toiqtty">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#131519">
  <Grid.Resources>
   <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#D7DBE2" />
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252930" />
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2D323B" />
   <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
   <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#20232A" />
   <ControlTemplate x:Key="ColumnSplitter" TargetType="Thumb"><Grid Background="{TemplateBinding Background}"><Border Width="1" Background="#292D34" HorizontalAlignment="Center"/></Grid></ControlTemplate>
   <ControlTemplate x:Key="RowSplitter" TargetType="Thumb"><Grid Background="{TemplateBinding Background}"><Border Height="1" Background="#292D34" VerticalAlignment="Center"/></Grid></ControlTemplate>
   <Style x:Key="ToolButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#9AA2AF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="FontSize" Value="12" />
   </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="#131519" BorderBrush="#292D34" BorderThickness="0,0,0,1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="TitleSidebarColumn" Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/><ColumnDefinition x:Name="CaptionInsetColumn" Width="138"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarHeader" Background="#16181D" BorderBrush="#292D34" BorderThickness="0,0,1,0">
     <Grid ColumnSpacing="7" Margin="12,0,6,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="SessionsLabel" Text="Sessions" FontSize="11" Foreground="#9AA2AF" VerticalAlignment="Center"/>
      <TextBlock x:Name="SessionCount" Grid.Column="1" FontSize="10" Foreground="#78818F" VerticalAlignment="Center"/>
      <Button x:Name="NewSessionButton" Grid.Column="2" Style="{StaticResource ToolButton}" Width="26" Click="NewWorkspaceClick" AutomationProperties.Name="New session"><FontIcon Glyph="&#xE710;" FontSize="11"/></Button>
      <Button x:Name="SidebarToggleButton" Grid.Column="3" Style="{StaticResource ToolButton}" Width="26" Click="SidebarClick" AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Toggle sidebar"><FontIcon Glyph="&#xE700;" FontSize="11"/></Button>
     </Grid>
   </Border>
   <Button x:Name="SidebarRestoreButton" Grid.Column="1" Style="{StaticResource ToolButton}" Width="26" Margin="3,0" Click="SidebarClick" AutomationProperties.Name="Show sidebar" Visibility="Collapsed"><FontIcon Glyph="&#xE700;" FontSize="11"/></Button>
   <Grid Grid.Column="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
    <ListView x:Name="TabStrip" HorizontalAlignment="Left" Height="31" MinHeight="0" Padding="0" BorderThickness="0" Background="Transparent"
        SelectionMode="Single" IsItemClickEnabled="True" ItemClick="TabItemClick" SelectionChanged="TabSelectionChanged" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
      DragItemsStarting="TabDragStarting" DragItemsCompleted="TabDragCompleted" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListView.Resources><x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean></ListView.Resources>
     <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="0"/>
     </Style></ListView.ItemContainerStyle>
    </ListView>
   </ScrollViewer>
    <Button x:Name="TabOverflowButton" Grid.Column="1" Style="{StaticResource ToolButton}" Width="26" Visibility="Collapsed"
        AutomationProperties.Name="All tabs" ToolTipService.ToolTip="All tabs">
     <Button.Content><FontIcon Glyph="&#xE70D;" FontSize="10"/></Button.Content>
     <Button.Flyout><MenuFlyout x:Name="TabOverflowMenu" Opening="TabOverflowOpening"/></Button.Flyout>
    </Button>
   </Grid>
     <StackPanel x:Name="TerminalActions" Grid.Column="3" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
      <Button x:Name="NewTabButton" Style="{StaticResource ToolButton}" Click="NewTabClick" AutomationProperties.Name="New tab"><FontIcon Glyph="&#xE710;" FontSize="11"/></Button>
      <Button x:Name="OpenDirectoryButton" Style="{StaticResource ToolButton}" Click="OpenDirectoryClick" AutomationProperties.Name="Open current folder in Windows Explorer"><FontIcon Glyph="&#xE8B7;" FontSize="12"/></Button>
      <Button Style="{StaticResource ToolButton}" AutomationProperties.Name="Browser actions" ToolTipService.ToolTip="Browser actions">
       <Button.Content><FontIcon Glyph="&#xE774;" FontSize="12"/></Button.Content>
       <Button.Flyout><MenuFlyout>
        <MenuFlyoutItem Text="New browser tab" Click="NewBrowserClick" />
        <MenuFlyoutItem Text="Split browser right" Click="SplitBrowserRightClick" />
        <MenuFlyoutItem Text="Split browser down" Click="SplitBrowserDownClick" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Profiles and cookie sharing" Click="BrowserSettingsClick" />
       </MenuFlyout></Button.Flyout>
      </Button>
      <Button x:Name="ShellButton" Style="{StaticResource ToolButton}" AutomationProperties.Name="Terminal actions" ToolTipService.ToolTip="Terminal actions">
       <Button.Content><FontIcon Glyph="&#xE712;" FontSize="12"/></Button.Content>
       <Button.Flyout><MenuFlyout x:Name="ShellMenu">
        <MenuFlyoutItem x:Name="SplitRightButton" Text="Split right" Click="SplitRightClick" />
        <MenuFlyoutItem x:Name="SplitDownButton" Text="Split down" Click="SplitDownClick" />
        <MenuFlyoutItem x:Name="ZoomButton" Text="Zoom focused pane" Click="ZoomClick" />
        <MenuFlyoutItem x:Name="ClosePaneMenuItem" Text="Close focused pane" Click="CloseFocusedPaneClick" />
          <MenuFlyoutItem x:Name="MovePaneMenuItem" Text="Move focused pane…" Click="MovePaneClick" />
        <MenuFlyoutSeparator />
       </MenuFlyout></Button.Flyout>
      </Button>
     </StackPanel>
   <Grid x:Name="TitleDragArea" Grid.Column="4" Background="Transparent"/>
  </Grid>
  <StackPanel Grid.Row="1">
  <InfoBar x:Name="StatusNotice" IsOpen="False" Severity="Error" Title="toiqtty"/>
  <InfoBar x:Name="LuaConfigBanner" IsOpen="False" Severity="Error" Title="Lua configuration error">
   <InfoBar.ActionButton><Button Content="Details" Click="LuaConfigStatusClick" /></InfoBar.ActionButton>
  </InfoBar>
  <InfoBar x:Name="PaneThemeHostNotice" IsOpen="False" Severity="Informational" IsClosable="False" Title="Pane colors need the new session host"
      Message="Use ‘Quit toiqtty and stop all sessions’ in the command palette, then reopen toiqtty and choose a theme. This stops running shells. Closing only the window keeps the older host running."/>
  </StackPanel>
  <Grid x:Name="WorkspaceBody" Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="#16181D" BorderBrush="#292D34" BorderThickness="0,0,1,0">
    <Grid Padding="0,3,0,5" RowSpacing="6">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <ListView x:Name="WorkspaceList" Grid.Row="0" SelectionChanged="WorkspaceSelectionChanged" DoubleTapped="WorkspaceDoubleTapped" IsDoubleTapEnabled="True" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single" IsItemClickEnabled="False" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsStarting="SessionDragStarting" DragItemsCompleted="SessionDragCompleted">
      <ListView.ItemContainerStyle>
       <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="52"/><Setter Property="CornerRadius" Value="0"/></Style>
      </ListView.ItemContainerStyle>
     </ListView>
     <StackPanel x:Name="SidebarActions" Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="8,0,0,0">
      <Button x:Name="PaletteButton" Style="{StaticResource ToolButton}" Width="28" Click="PaletteClick" AutomationProperties.Name="Command palette"><FontIcon Glyph="&#xE721;" FontSize="12"/></Button>
      <Button Style="{StaticResource ToolButton}" Width="28" Click="SettingsClick" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"><FontIcon Glyph="&#xE713;" FontSize="12"/></Button>
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="PaneHost" Grid.Column="1"/>
  </Grid>
  <Grid x:Name="StatusBar" Grid.Row="3" Visibility="Collapsed" Height="20" Background="#131519" BorderBrush="#292D34" BorderThickness="0,1,0,0" Padding="10,0" ColumnSpacing="14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Foreground="#78818F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <TextBlock x:Name="SessionStatus" Grid.Column="1" FontSize="10" Foreground="#78818F" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>
