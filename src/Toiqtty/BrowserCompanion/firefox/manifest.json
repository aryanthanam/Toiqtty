{
  "manifest_version": 3,
  "name": "toiqtty Browser Companion",
  "version": "0.3.0",
  "description": "Share cookies for sites you choose with your local toiqtty browser panes.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "toiqtty cookie sharing" },
  "background": { "scripts": ["bridge.js", "background.js"] },
  "browser_specific_settings": { "gecko": { "id": "browser-companion@toiqtty.local", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } } }
}
