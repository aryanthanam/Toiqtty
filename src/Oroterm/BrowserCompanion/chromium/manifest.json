{
  "manifest_version": 3,
  "name": "Oroterm Browser Companion",
  "version": "0.3.0",
  "description": "Share cookies for sites you choose with your local Oroterm browser panes.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "Oroterm cookie sharing" },
  "background": { "service_worker": "background.js" }
}
